# Export settings before starting Python; .env is not loaded automatically.
FRONTEND_AGENT_MODEL=qwen3:latest
OLLAMA_HOST=http://127.0.0.1:11434
FRONTEND_AGENT_CONTEXT_LENGTH=16384
FRONTEND_AGENT_MAX_TOKENS=8192
# FRONTEND_AGENT_REASONING=false
# FRONTEND_AGENT_DATA_DIR=/absolute/path/to/forma-data
FRONTEND_AGENT_SANDBOX_BACKEND=auto
FRONTEND_AGENT_SANDBOX_IMAGE=node:22-alpine
FRONTEND_AGENT_COMMAND_TIMEOUT=180
FRONTEND_AGENT_MAX_REPAIRS=2
FRONTEND_AGENT_RAG=0
# FRONTEND_AGENT_EMBEDDING_MODEL=qwen3-embedding:4b

# Optional compatible Chat Completions provider. Keys stay on the server.
# FRONTEND_AGENT_API_BASE_URL=https://your-provider.example/v1
# FRONTEND_AGENT_API_MODEL=your-model-id
# FRONTEND_AGENT_API_KEY=
FRONTEND_AGENT_STRUCTURED_OUTPUT=json_mode

# Required when binding beyond loopback. Use a long random access token.
# FRONTEND_AGENT_ACCESS_TOKEN=
# FRONTEND_AGENT_PUBLIC_ORIGIN=https://studio.example.com
# Hosted previews need a separate origin, protected at the reverse proxy.
# FRONTEND_AGENT_PREVIEW_BIND=127.0.0.1
# FRONTEND_AGENT_PREVIEW_PORT=8788
# FRONTEND_AGENT_PREVIEW_ORIGIN=https://preview.example.net
